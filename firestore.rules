rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow delete: if ownsExistingDocument() && userId == request.auth.uid;
      allow update: if ownsExistingDocument()
        && ownsIncomingDocument()
        && userId == request.auth.uid;
    }

    // Derived uniqueness claims for Google contact links; no credentials or contact data.
    match /googleContactLinks/{claimId} {
      allow get: if isSignedIn() && (!exists(/databases/$(database)/documents/googleContactLinks/$(claimId)) || ownsExistingDocument());
      allow list, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument()
        && request.resource.data.keys().hasOnly(['ownerId', 'personId'])
        && getAfter(/databases/$(database)/documents/people/$(request.resource.data.personId)).data.ownerId == request.auth.uid;
      allow update: if ownsExistingDocument() && ownsIncomingDocument()
        && request.resource.data.keys().hasOnly(['ownerId', 'personId'])
        && (request.resource.data.personId == resource.data.personId
          || (!exists(/databases/$(database)/documents/people/$(resource.data.personId))
            && getAfter(/databases/$(database)/documents/people/$(request.resource.data.personId)).data.ownerId == request.auth.uid));
    }

    match /{collection}/{documentId} {
      allow create: if collection in [
        'people',
        'relationships',
        'importantDates',
        'personNotes',
        'memories',
        'interactions',
        'groups',
        'reminders'
      ] && ownsIncomingDocument();
      // Transactions must be able to check a destination before creating it.
      // This grants no access to an existing record owned by someone else.
      allow get: if isSignedIn()
        && collection in ['people', 'relationships', 'importantDates', 'personNotes', 'memories', 'interactions', 'groups', 'reminders']
        && (!exists(/databases/$(database)/documents/$(collection)/$(documentId)) || ownsExistingDocument());
      allow list, delete: if collection in [
        'people',
        'relationships',
        'importantDates',
        'personNotes',
        'memories',
        'interactions',
        'groups',
        'reminders'
      ] && ownsExistingDocument();
      allow update: if collection in [
        'people',
        'relationships',
        'importantDates',
        'personNotes',
        'memories',
        'interactions',
        'groups',
        'reminders'
      ] && ownsExistingDocument() && ownsIncomingDocument();
    }
  }
}
